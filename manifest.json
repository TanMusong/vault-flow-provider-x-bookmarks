{
  "id": "x-bookmarks",
  "name": {
    "zh-CN": "X书签下载",
    "zh-TW": "X書籤下載",
    "en-US": "X Bookmarks Download"
  },
  "description": {
    "zh-CN": "将 X 书签转化为下载任务流",
    "zh-TW": "將 X 書籤轉化為下載任務流",
    "en-US": "Convert X bookmarks into download task flow"
  },
  "site": {
    "zh-CN": "X",
    "zh-TW": "X",
    "en-US": "X"
  },
  "icon": "assets/icon.webp",
  "cookieDomains": [".x.com"],
  "version": "https://github.com/TanMusong/vault-flow-provider-x-bookmarks/releases/latest/download/version.json",
  "config": [
    {
      "key": "cookies",
      "name": "Cookie",
      "type": "textarea",
      "placeholder": { "zh-CN": "在此粘贴 Cookie", "zh-TW": "在此貼上 Cookie", "en-US": "Paste your cookies here" }
    },
    {
      "key": "downloadPath",
      "name": { "zh-CN": "下载路径模板", "zh-TW": "下載路徑模板", "en-US": "Download Path Template" },
      "type": "text",
      "default": "{type}/{user}/{author_id}_{author}",
      "placeholder": { "zh-CN": "{type}/{user}/{author_id}_{author}", "zh-TW": "{type}/{user}/{author_id}_{author}", "en-US": "{type}/{user}/{author_id}_{author}" }
    },
    {
      "key": "maxConcurrent",
      "name": { "zh-CN": "最大并发下载", "zh-TW": "最大並行下載", "en-US": "Max Concurrent Downloads" },
      "type": "number",
      "default": 3
    },
    {
      "key": "timeout",
      "name": { "zh-CN": "超时（秒）", "zh-TW": "逾時（秒）", "en-US": "Timeout (seconds)" },
      "type": "number",
      "default": 60
    },
    {
      "key": "maxRetries",
      "name": { "zh-CN": "最大重试次数", "zh-TW": "最大重試次數", "en-US": "Max Retries" },
      "type": "number",
      "default": 3
    },
    {
      "key": "proxyEnabled",
      "name": { "zh-CN": "代理", "zh-TW": "代理", "en-US": "Proxy" },
      "type": "checkbox",
      "default": false,
      "on": [
        {
          "key": "proxyType",
          "name": { "zh-CN": "代理类型", "zh-TW": "代理類型", "en-US": "Proxy Type" },
          "type": "select",
          "default": "socks5",
          "values": [
            { "key": "socks5", "name": { "zh-CN": "SOCKS5", "zh-TW": "SOCKS5", "en-US": "SOCKS5" } },
            { "key": "http", "name": { "zh-CN": "HTTP", "zh-TW": "HTTP", "en-US": "HTTP" } },
            { "key": "https", "name": { "zh-CN": "HTTPS", "zh-TW": "HTTPS", "en-US": "HTTPS" } }
          ]
        },
        {
          "key": "proxyHost",
          "name": { "zh-CN": "代理地址", "zh-TW": "代理地址", "en-US": "Proxy Host" },
          "type": "text",
          "default": "127.0.0.1"
        },
        {
          "key": "proxyPort",
          "name": { "zh-CN": "代理端口", "zh-TW": "代理端口", "en-US": "Proxy Port" },
          "type": "number",
          "default": 7890
        }
      ]
    }
  ]
}
